# Runtime secrets of server-app. Copy to .env (git ignores it) readable by its owner only, then fill
# in; never commit values:
#   install -m 600 .env.example .env    (or cp .env.example .env && chmod 600 .env)
# On a server the service user owns it: install -m 600 -o <service user> (docs/DESIGN-PROD.md §23).
# Shared secrets live in Bitwarden under the key name: `bw get password <KEY>`.
# See docs/DESIGN-PROD.md API-PROD-004, API-PROD-006, API-PROD-022 and API-PROD-028.

# Player store (PostgreSQL 16), read when -Dsynaxis.app.store=postgres.
# JDBC URL of the store database, e.g. jdbc:postgresql://host:5432/synaxis
SYNAXIS_STATE_DB_URL=
# A shard's account needs DML only; the --migrate-only release job uses an account that may run DDL
SYNAXIS_STATE_DB_USER=
SYNAXIS_STATE_DB_PASSWORD=

# Valkey 8 holding the disposable data (presence, kick requests), e.g. redis://host:6379, with a
# password redis://:<password>@host:6379; percent-encode the reserved characters of the password
# ('/' as %2F, which openssl rand -base64 makes; '%' as %25, '#' as %23, '@' as %40).
# Unset runs without it: a login of an account online on another shard is then refused.
SYNAXIS_REDIS_URL=

# HMAC-SHA256 keys of the transfer tickets, key_id:base64 separated by commas, 1 or 2 of them, each
# key exactly 32 bytes (openssl rand -base64 32). The first one signs. Every shard of the deployment
# holds the same value; required when -Dsynaxis.accept-transfers=true.
# Rotation: add the new key as the second entry and roll every shard, move it to the first entry and
# roll again, drop the old one 30 s later.
SYNAXIS_TRANSFER_HMAC_KEYS=

# Bearer token of the management interface (docs/DESIGN-PROD.md API-PROD-022), read only when
# -Dsynaxis.app.management.enabled=true, and then required: a shard with the interface enabled and
# no token refuses to start. 32 to 512 characters of A-Z a-z 0-9 - . _ ~ + / (optionally ending in
# '='): generate one with `openssl rand -hex 32` and keep it in Bitwarden under this key name.
# Clients send it as `Authorization: Bearer <token>` on the WebSocket upgrade request.
SYNAXIS_MANAGEMENT_TOKEN=
