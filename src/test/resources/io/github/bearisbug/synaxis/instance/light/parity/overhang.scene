# 屋檐：柱子撑起的木板屋顶（跨 x=0、x=16、z=0、z=16 的区块边界与 y=32 的 section 边界），
# 檐口一圈上半台阶与倒置楼梯，屋顶开一个天窗；旁边一个玻璃屋顶和一个深色（染色）玻璃屋顶。
fill -32 0 -32 47 9 47 minecraft:stone
fill -32 10 -32 47 10 47 minecraft:grass_block
fill -8 11 -8 -8 31 -8 minecraft:oak_log
fill 23 11 -8 23 31 -8 minecraft:oak_log
fill -8 11 23 -8 31 23 minecraft:oak_log
fill 23 11 23 23 31 23 minecraft:oak_log
fill -8 32 -8 23 32 23 minecraft:oak_planks
# 檐口
fill -9 32 -9 24 32 -9 minecraft:oak_slab[type=top]
fill -9 32 24 24 32 24 minecraft:oak_slab[type=top]
fill -9 32 -8 -9 32 23 minecraft:oak_stairs[facing=east,half=top]
fill 24 32 -8 24 32 23 minecraft:oak_stairs[facing=west,half=top]
# 天窗
fill 6 32 6 9 32 9 minecraft:air
# 屋顶下一层低矮的挑檐，y=15/16 section 边界
fill -2 16 -2 17 16 17 minecraft:spruce_slab[type=bottom]
fill 2 16 2 13 16 13 minecraft:air
# 玻璃屋顶与染色玻璃屋顶
